# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chiave "service_role": SOLO lato server, serve all'admin per creare gli account dei collaboratori.
# Non va mai esposta nel browser né committata.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Notifiche push (generare con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:tua@email.it
